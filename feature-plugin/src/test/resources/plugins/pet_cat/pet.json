{
  "type": "column",
  "anchor": "bottom_right",
  "offsetX": -72,
  "offsetY": -250,
  "gap": 8,
  "children": [
    {
      "type": "bubble",
      "visibleWhen": "state.showBubble",
      "animation": { "type": "scale", "durationMs": 180 },
      "onTap": "onPetTap",
      "children": [
        { "type": "text", "textFrom": "state.line", "size": "body", "color": "onSurface", "maxLines": 2 },
        { "type": "text", "textFrom": "state.hint", "size": "caption", "color": "muted" }
      ]
    },
    {
      "type": "image",
      "src": "assets/cat_idle.png",
      "width": 88,
      "height": 88,
      "onTap": "onPetTap",
      "animation": { "type": "sprite", "frames": ["assets/cat_idle.png", "assets/cat_tap.png"], "fps": 2 }
    }
  ]
}
