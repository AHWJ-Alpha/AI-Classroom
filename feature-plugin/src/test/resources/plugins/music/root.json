{
  "type": "box",
  "anchor": "bottom_right",
  "offsetX": -16,
  "offsetY": -100,
  "visibleWhen": "state.shown",
  "children": [
    {
      "type": "box",
      "anchor": "bottom_right",
      "offsetY": -108,
      "width": 40,
      "height": 40,
      "radius": "full",
      "visibleWhen": "state.circle",
      "onTap": "onCircleTap",
      "onLongPress": "onCompact",
      "children": [
        {
          "type": "disk",
          "size": 40,
          "coverFrom": "state.artworkPath",
          "spinningFrom": "state.playing",
          "color": "surfaceVariant"
        },
        {
          "type": "icon",
          "name": "music",
          "size": 18,
          "color": "primary",
          "anchor": "center",
          "visibleWhen": "state.noArt"
        }
      ]
    },
    {
      "type": "card",
      "anchor": "bottom_right",
      "width": 220,
      "radius": "card",
      "background": "surface",
      "gap": 8,
      "visibleWhen": "state.collapsed",
      "onTap": "onExpand",
      "onLongPress": "onCompact",
      "children": [
        {
          "type": "row",
          "gap": 10,
          "children": [
            {
              "type": "box",
              "width": 44,
              "height": 44,
              "radius": "control",
              "background": "surfaceVariant",
              "children": [
                {
                  "type": "icon",
                  "name": "music",
                  "size": 20,
                  "color": "muted",
                  "anchor": "center",
                  "visibleWhen": "state.noArt"
                },
                {
                  "type": "image",
                  "src": "state.artworkPath",
                  "width": 44,
                  "height": 44,
                  "radius": "control",
                  "anchor": "center",
                  "visibleWhen": "state.hasArt"
                }
              ]
            },
            {
              "type": "column",
              "width": "fill",
              "gap": 2,
              "children": [
                {
                  "type": "text",
                  "textFrom": "state.title",
                  "size": "body",
                  "color": "onSurface",
                  "weight": "bold",
                  "maxLines": 1,
                  "width": "fill"
                },
                {
                  "type": "text",
                  "textFrom": "state.artist",
                  "size": "caption",
                  "color": "muted",
                  "maxLines": 1,
                  "width": "fill"
                }
              ]
            }
          ]
        },
        {
          "type": "row",
          "gap": 8,
          "children": [
            {
              "type": "progress",
              "valueFrom": "state.progress",
              "width": "fill",
              "height": 4,
              "color": "accent"
            },
            {
              "type": "text",
              "textFrom": "state.positionText",
              "size": "caption",
              "color": "muted"
            }
          ]
        }
      ]
    },
    {
      "type": "card",
      "anchor": "bottom_right",
      "width": 320,
      "radius": "panel",
      "background": "surface",
      "gap": 10,
      "visibleWhen": "state.expanded",
      "onTap": "onCollapse",
      "onLongPress": "onCompact",
      "children": [
        {
          "type": "row",
          "gap": 12,
          "children": [
            {
              "type": "box",
              "width": 72,
              "height": 72,
              "radius": "control",
              "background": "surfaceVariant",
              "children": [
                {
                  "type": "icon",
                  "name": "music",
                  "size": 28,
                  "color": "muted",
                  "anchor": "center",
                  "visibleWhen": "state.noArt"
                },
                {
                  "type": "image",
                  "src": "state.artworkPath",
                  "width": 72,
                  "height": 72,
                  "radius": "control",
                  "anchor": "center",
                  "visibleWhen": "state.hasArt"
                }
              ]
            },
            {
              "type": "column",
              "width": "fill",
              "gap": 4,
              "children": [
                {
                  "type": "waveform",
                  "width": "fill",
                  "height": 40,
                  "bars": 16,
                  "amplitude": 0.3,
                  "color": "primary",
                  "activeFrom": "state.playing",
                  "accentAt": "edges"
                },
                {
                  "type": "text",
                  "textFrom": "state.title",
                  "size": "body",
                  "color": "onSurface",
                  "weight": "bold",
                  "maxLines": 1,
                  "width": "fill"
                },
                {
                  "type": "text",
                  "textFrom": "state.artist",
                  "size": "caption",
                  "color": "muted",
                  "maxLines": 1,
                  "width": "fill"
                }
              ]
            }
          ]
        },
        {
          "type": "box",
          "width": "fill",
          "children": [
            {
              "type": "row",
              "anchor": "center",
              "gap": 16,
              "children": [
                {
                  "type": "box",
                  "width": 44,
                  "height": 44,
                  "radius": "full",
                  "onTap": "onPrev",
                  "children": [
                    {
                      "type": "icon",
                      "name": "prev",
                      "size": 26,
                      "color": "muted",
                      "anchor": "center"
                    }
                  ]
                },
                {
                  "type": "box",
                  "width": 44,
                  "height": 44,
                  "radius": "full",
                  "background": "surfaceVariant",
                  "onTap": "onToggle",
                  "children": [
                    {
                      "type": "icon",
                      "name": "pause",
                      "size": 24,
                      "color": "accent",
                      "anchor": "center",
                      "visibleWhen": "state.playing"
                    },
                    {
                      "type": "icon",
                      "name": "play",
                      "size": 24,
                      "color": "accent",
                      "anchor": "center",
                      "visibleWhen": "state.paused"
                    }
                  ]
                },
                {
                  "type": "box",
                  "width": 44,
                  "height": 44,
                  "radius": "full",
                  "onTap": "onNext",
                  "children": [
                    {
                      "type": "icon",
                      "name": "next",
                      "size": 26,
                      "color": "muted",
                      "anchor": "center"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "row",
          "gap": 8,
          "children": [
            {
              "type": "progress",
              "valueFrom": "state.progress",
              "width": "fill",
              "height": 4,
              "color": "accent"
            },
            {
              "type": "text",
              "textFrom": "state.timeText",
              "size": "caption",
              "color": "muted"
            }
          ]
        }
      ]
    }
  ]
}
