{
  "type": "box",
  "anchor": "bottom_right",
  "offsetX": -16,
  "offsetY": -180,
  "visibleWhen": "state.shown",
  "children": [
    {
      "type": "box",
      "anchor": "bottom_right",
      "offsetY": 0,
      "radius": "full",
      "children": [
        {
          "type": "disk",
          "coverFrom": "state.artworkPath",
          "spinningFrom": "state.playing",
          "color": "surfaceVariant",
          "widthFrom": "state.circleSize"
        },
        {
          "type": "icon",
          "name": "music",
          "size": 24,
          "color": "primary",
          "anchor": "center",
          "visibleWhen": "state.noArt"
        }
      ],
      "draggable": true,
      "snapTo": "free",
      "onDoubleTap": "onExpand",
      "onTap": "onExpand",
      "widthFrom": "state.circleSize",
      "heightFrom": "state.circleSize",
      "visibleWhen": "state.circle"
    },
    {
      "type": "card",
      "visibleWhen": "state.expanded",
      "anchor": "bottom_right",
      "offsetX": 0,
      "offsetY": 0,
      "radius": "panel",
      "background": "surface",
      "padding": 14,
      "gap": 10,
      "draggable": true,
      "snapTo": "free",
      "onDoubleTap": "onCollapse",
      "children": [
        {
          "type": "row",
          "gap": 12,
          "children": [
            {
              "type": "box",
              "width": 80,
              "height": 80,
              "radius": "full",
              "children": [
                {
                  "type": "disk",
                  "size": 80,
                  "coverFrom": "state.artworkPath",
                  "spinningFrom": "state.playing",
                  "color": "surfaceVariant",
                  "elevation": 0
                },
                {
                  "type": "icon",
                  "name": "music",
                  "size": 30,
                  "color": "primary",
                  "anchor": "center",
                  "visibleWhen": "state.noArt"
                }
              ]
            },
            {
              "type": "column",
              "width": "fill",
              "gap": 4,
              "children": [
                {
                  "type": "text",
                  "textFrom": "state.title",
                  "size": "body",
                  "color": "onSurface",
                  "weight": "bold",
                  "maxLines": 1
                },
                {
                  "type": "text",
                  "textFrom": "state.artist",
                  "size": "caption",
                  "color": "muted",
                  "maxLines": 1
                },
                {
                  "type": "waveform",
                  "width": "fill",
                  "height": 26,
                  "bars": 14,
                  "amplitude": 0.3,
                  "color": "primary",
                  "accentAt": "edges",
                  "activeFrom": "state.playing"
                },
                {
                  "type": "box",
                  "width": "fill",
                  "children": [
                    {
                      "type": "row",
                      "anchor": "center",
                      "gap": 14,
                      "children": [
                        {
                          "type": "box",
                          "width": 36,
                          "height": 36,
                          "radius": "full",
                          "background": "transparent",
                          "onTap": "onPrev",
                          "children": [
                            {
                              "type": "icon",
                              "name": "prev",
                              "size": 22,
                              "color": "muted",
                              "anchor": "center"
                            }
                          ]
                        },
                        {
                          "type": "box",
                          "width": 46,
                          "height": 46,
                          "radius": "full",
                          "background": "surfaceVariant",
                          "onTap": "onToggle",
                          "children": [
                            {
                              "type": "icon",
                              "name": "pause",
                              "size": 24,
                              "color": "primary",
                              "anchor": "center",
                              "visibleWhen": "state.playing"
                            },
                            {
                              "type": "icon",
                              "name": "play",
                              "size": 24,
                              "color": "primary",
                              "anchor": "center",
                              "visibleWhen": "state.paused"
                            }
                          ]
                        },
                        {
                          "type": "box",
                          "width": 36,
                          "height": 36,
                          "radius": "full",
                          "background": "transparent",
                          "onTap": "onNext",
                          "children": [
                            {
                              "type": "icon",
                              "name": "next",
                              "size": 22,
                              "color": "muted",
                              "anchor": "center"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "row",
          "gap": 8,
          "children": [
            {
              "type": "progress",
              "valueFrom": "state.progress",
              "width": "fill",
              "height": 3,
              "color": "primary"
            },
            {
              "type": "text",
              "textFrom": "state.timeText",
              "size": "caption",
              "color": "muted"
            }
          ]
        }
      ],
      "onTap": "onCollapse",
      "widthFrom": "state.panelWidth",
      "bordered": false
    }
  ],
  "draggable": false
}
