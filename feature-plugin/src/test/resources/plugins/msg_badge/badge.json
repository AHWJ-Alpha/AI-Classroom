{
  "type": "row",
  "gap": 4,
  "children": [
    { "type": "icon", "name": "star", "size": 12, "color": "muted" },
    { "type": "text", "textFrom": "msg.chars", "size": "caption", "color": "muted" },
    { "type": "text", "text": "字", "size": "caption", "color": "muted" },
    { "type": "text", "text": "·", "size": "caption", "color": "muted" },
    { "type": "text", "textFrom": "state.lastSeconds", "size": "caption", "color": "muted" },
    { "type": "text", "text": "秒", "size": "caption", "color": "muted" },
    { "type": "spacer", "width": 8, "height": 1 },
    { "type": "text", "textFrom": "state.totalLabel", "size": "caption", "color": "primary", "visibleWhen": "state.hasHistory" }
  ]
}
