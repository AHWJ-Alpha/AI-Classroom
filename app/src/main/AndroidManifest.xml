<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 一键播放要按包名拉起「上次用过的播放器」。Android 11+ 的包可见性默认查不到别的 App，
         不声明这条 queries 的话 PackageManager.getLaunchIntentForPackage 会返回 null。 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>
    <!-- Used by Android's system haptic feedback for key knowledge-base actions. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- 本地生图（SD WebUI / 自定义）与局域网服务只提供 http，targetSdk 35 默认拦明文，
         所以全局放开；https 仍走系统信任链校验。 -->
    <application
        android:usesCleartextTraffic="true"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="AI Classroom"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AIClassroom">
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="true"
            android:theme="@style/Theme.AIClassroom">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 考试拍照作答：TakePicture 要往一个 content:// uri 里写，FileProvider 把
             filesDir/images/ 暴露给系统相机 App（authority 固定 ${applicationId}.fileprovider）。 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <service
            android:name=".media.MediaNotificationListener"
            android:exported="false"
            android:label="AI Classroom 音乐"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>

</manifest>
